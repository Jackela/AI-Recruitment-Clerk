#!/usr/bin/env sh
set -e

# Skip local CI for delete-only pushes.
delete_only=1
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    delete_only=0
    break
  fi
done

if [ "$delete_only" -eq 1 ]; then
  echo "⏭️  Skipping ci:local for delete-only push"
  exit 0
fi

# Allow skipping pre-push checks with environment variable
if [ "$SKIP_PRE_PUSH" = "true" ]; then
  echo "⏭️  Skipping pre-push checks (SKIP_PRE_PUSH=true)"
  exit 0
fi

# Quick mode - only run essential checks (under 2 minutes)
if [ "$QUICK_PUSH" = "true" ]; then
  echo "🚀 Running QUICK pre-push checks..."
  echo ""
  
  # 1. Lint affected only
  echo "📋 Step 1/2: Linting affected projects..."
  npx nx affected:lint --base=origin/main --head=HEAD --parallel=3
  echo "✅ Lint passed"
  echo ""
  
  # 2. Typecheck affected only
  echo "🔍 Step 2/2: Type-checking affected projects..."
  npx nx affected --target=typecheck --base=origin/main --head=HEAD --parallel=3
  echo "✅ Typecheck passed"
  echo ""
  
  echo "✅ Quick checks passed! Full CI will run on GitHub Actions."
  exit 0
fi

echo "🚀 Running ENHANCED pre-push CI checks..."
echo "⏱️  This will test ALL projects. May take 10-15 minutes."
echo "   Tip: Use QUICK_PUSH=true for faster checks (2 minutes)"
echo "   Or SKIP_PRE_PUSH=true to skip entirely"
echo ""

# Start time
START_TIME=$(date +%s)

# 1. Lint affected (not all - faster)
echo "📋 Step 1/8: Linting affected projects (including any-type check)..."
npx nx affected:lint --base=origin/main --head=HEAD --parallel=3
echo "✅ Lint passed (no any types found)"
echo ""

# 2. Format check affected only
echo "🎨 Step 2/8: Checking code formatting..."
FORMAT_FILES=$(git diff --name-only --diff-filter=ACMR origin/main...HEAD -- apps libs | grep -E '\.(ts|html|scss|js|json|md)$' || true)
if [ -n "$FORMAT_FILES" ]; then
  printf '%s\n' "$FORMAT_FILES" | xargs npx prettier --check || {
    echo "❌ Code formatting issues found. Run 'npm run format' to fix."
    exit 1
  }
else
  echo "No affected app/lib files require formatting checks."
fi
echo "✅ Format check passed"
echo ""

# 3. Typecheck affected
echo "🔍 Step 3/8: Type-checking affected projects..."
npx nx affected --target=typecheck --base=origin/main --head=HEAD --parallel=3
echo "✅ Typecheck passed"
echo ""

# 4. Security audit (quick mode - only high severity)
echo "🔒 Step 4/8: Running security audit..."
npm audit --audit-level=high || {
  echo "⚠️  Security vulnerabilities found. Review with: npm audit"
  echo "   To fix automatically: npm audit fix"
  echo "   Continuing despite warnings..."
}
echo ""

# 5. All unit tests with coverage
echo "🧪 Step 5/8: Running ALL unit tests with coverage..."
npm run test:coverage

# Check coverage thresholds using the same machine-readable report and
# quality-gate config used by CI tooling.
COVERAGE_FILE="coverage/coverage-summary.json"
QUALITY_GATES_FILE="config/quality-gates.json"
if [ -f "$COVERAGE_FILE" ]; then
  LINE_COVERAGE=$(node -e "const fs=require('fs'); const s=JSON.parse(fs.readFileSync(process.argv[1],'utf8')); console.log(s.total?.lines?.pct ?? 0)" "$COVERAGE_FILE")
  BRANCH_COVERAGE=$(node -e "const fs=require('fs'); const s=JSON.parse(fs.readFileSync(process.argv[1],'utf8')); console.log(s.total?.branches?.pct ?? 0)" "$COVERAGE_FILE")
  COVERAGE_THRESHOLD=$(node -e "const fs=require('fs'); const p=process.argv[1]; const cfg=fs.existsSync(p)?JSON.parse(fs.readFileSync(p,'utf8')):{}; console.log(typeof cfg.coverage === 'number' ? cfg.coverage * 100 : 80)" "$QUALITY_GATES_FILE")

  echo "📊 Coverage Report:"
  echo "   Lines: ${LINE_COVERAGE}%"
  echo "   Branches: ${BRANCH_COVERAGE}%"
  echo "   Required line threshold: ${COVERAGE_THRESHOLD}%"

  if ! node -e "process.exit(Number(process.argv[1]) + 1e-9 >= Number(process.argv[2]) ? 0 : 1)" "$LINE_COVERAGE" "$COVERAGE_THRESHOLD"; then
    echo "❌ Line coverage is below configured threshold"
    exit 1
  fi
  echo "✅ Coverage threshold met"
fi
echo ""

# 6. Build all (including frontend for E2E)
echo "🔨 Step 6/8: Building ALL projects..."
npm run build

# Build frontend specifically for E2E
echo "📦 Building frontend for E2E..."
npx nx run ai-recruitment-frontend:build:production
echo "✅ Build passed"
echo ""

# 7. Start static server for E2E in background
echo "🌐 Starting static server for E2E..."
npx serve dist/apps/ai-recruitment-frontend/browser -l 4200 -s --proxy /api=http://localhost:3000 > /tmp/e2e-server.log 2>&1 &
SERVER_PID=$!
echo "Server started with PID: $SERVER_PID"

# Wait for server to be ready
echo "Waiting for server to be ready..."
for i in $(seq 1 30); do
  if curl -s http://localhost:4200 > /dev/null 2>&1; then
    echo "✅ Server is ready!"
    break
  fi
  if [ $i -eq 30 ]; then
    echo "❌ Server failed to start"
    cat /tmp/e2e-server.log
    kill $SERVER_PID 2>/dev/null
    exit 1
  fi
  sleep 1
done

# 8. E2E tests - MUST PASS
# Skip slow PDF tests that require backend API (@pdf-variety, @real-data tags)
echo "🎭 Step 7/8: Running E2E tests (skipping slow PDF integration tests)..."
export CI=true
export E2E_SKIP_WEBSERVER=true
export PLAYWRIGHT_BASE_URL=http://localhost:4200
cd apps/ai-recruitment-frontend-e2e && npx playwright test --grep-invert '@pdf-variety|@real-data'
E2E_EXIT_CODE=$?

# Stop the server
echo "Stopping server..."
kill $SERVER_PID 2>/dev/null || true
wait $SERVER_PID 2>/dev/null || true

if [ $E2E_EXIT_CODE -ne 0 ]; then
  echo "❌ E2E tests failed"
  exit 1
fi
echo "✅ E2E tests passed"
echo ""

# 9. Nx affected test (quick sanity check)
echo "🔄 Step 8/8: Running affected tests..."
cd ../..
npx nx affected:test --base=main --head=HEAD --parallel=4 || {
  echo "⚠️  Some affected tests failed, but continuing..."
}
echo ""

# Calculate elapsed time
END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))
MINUTES=$((ELAPSED / 60))
SECONDS=$((ELAPSED % 60))

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ ALL ENHANCED pre-push checks passed!"
echo "⏱️  Total time: ${MINUTES}m ${SECONDS}s"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
